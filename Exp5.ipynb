   "source": [
    "# Experiment 5: CFG Parsing\n",
    "import nltk\n",
    "grammar = nltk.CFG.fromstring(\"\"\"\n",
    "S -> NP VP\n",
    "NP -> Det N\n",
    "VP -> V NP\n",
    "Det -> 'the' | 'a'\n",
    "N -> 'student' | 'book'\n",
    "V -> 'reads'\n",
    "\"\"\")\n",
    "for tree in nltk.ChartParser(grammar).parse('the student reads a book'.split()):\n",
    "    print(tree)\n"
   ]
  }
